{
  "mcpServers": {
    "explain_visually": {
      "command": "node",
      "args": ["./mcp/explain-visually.mjs"],
      "cwd": ".",
      "env_vars": [
        "EXPLAIN_VISUALLY_ENV",
        "EXPLAIN_VISUALLY_API_URL",
        "EXPLAIN_VISUALLY_FRONTEND_URL"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600
    }
  }
}
